<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_discount" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.control.invoice.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="max_invoice_discount_setting"
                            string="Limitare Discount Facturi"
                            help="Setează valoarea maximă a discountului ce poate fi acordat per linie de factură.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="max_invoice_discount" class="col-lg-4 o_light_label"/>
                            <div>
                                <field name="max_invoice_discount" class="oe_inline"/>
                                <span>%</span>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
